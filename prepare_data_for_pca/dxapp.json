{
  "name": "prepare_data_for_pca",
  "title": "step one: PCA",
  "summary": "Does the data prep for input to PCA analysis",
  "dxapi": "1.0.0",
  "version": "0.0.1",
  "inputSpec": [
    {
      "name": "maf",
      "label": "minor allele freq",
      "class": "string",
      "optional": true,
      "default": "0.01",
      "help": ""
    },
    {
      "name": "iterative_missingness_params",
      "label": "mininimum n individuals with recording for a marker",
      "class": "string",
      "optional": true,
      "default": "90 97 1",
      "help": ""
    },
    {
      "name": "chroms",
      "label": "chromosomes to assess",
      "class": "string",
      "optional": true,
      "default": "1-22, XY",
      "help": ""
    },


    {
      "name": "ld_params",
      "label": "LD params for plink",
      "class": "string",
      "optional": true,
      "default": "1500 150 0.2",
      "help": ""
    },
    {
      "name": "geno",
      "label": "percentage threshold for genotyope call",
      "class": "string",
      "optional": true,
      "default": "0.1",
      "help": ""
    },
    {
      "name": "output_prefix",
      "class": "array:string",
      "optional": false,
      "help": ""
    }
  ],
  "outputSpec": [
    {
      "name": "PC_data",
      "label": "output PCs",
      "class": "file",
      "patterns": [
        "*"
      ],
      "help": ""
    }
  ],
  "runSpec": {
    "timeoutPolicy": {
      "*": {
        "hours": 48
      }
    },
    "interpreter": "bash",
    "file": "src/compute_pcs.sh",
    "distribution": "Ubuntu",
    "release": "20.04",
    "version": "0"
  },
  "access": {
    "project": "CONTRIBUTE"
  },
  "regionalOptions": {
    "aws:eu-west-2": {
      "systemRequirements": {
        "*": {
          "instanceType": "mem1_ssd1_v2_x72"
        }
      }
    }
  }
}
